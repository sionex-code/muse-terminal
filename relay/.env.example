# ---------- VPS (server) ----------
PORT=8787
HOST=127.0.0.1
# Token Muse sends as: Authorization: Bearer <MCP_TOKEN>
MCP_TOKEN=change-me-mcp-token
# Token each worker machine sends when it connects
WORKER_TOKEN=change-me-worker-token
# Keep at most this many log lines per task in memory
TASK_LOG_LIMIT=4000
# Drop finished tasks after this many seconds
TASK_TTL_SECONDS=3600

# ---------- Your PC (worker) ----------
RELAY_URL=wss://relay.example.com/agent
WORKER_NAME=my-pc
# Must match WORKER_TOKEN above
WORKER_TOKEN=change-me-worker-token
# Which coding agent runs the prompt: opencode | claude | custom
ENGINE=opencode
# Only used when ENGINE=custom. {{PROMPT}} is replaced with the prompt.
CUSTOM_AGENT_CMD=
# Colon separated list of directories the worker is allowed to touch.
WORKER_ROOTS=/home/you/projects
# Default working directory when a task does not name one
WORKER_DEFAULT_CWD=/home/you/projects
# Seconds before a task is killed
TASK_TIMEOUT=900
# Set to 1 to allow muse_run_shell on this worker
ALLOW_SHELL=1
# 1 passes --auto to opencode: there is no terminal to answer a permission prompt.
# Set to 0 on a machine where a task should fail rather than act unattended.
AUTO_APPROVE=1
# Optional default model and agent profile, as provider/model
AGENT_MODEL=
AGENT_PROFILE=

# ---------- operator CLI (any machine) ----------
# Where the CLI sends MCP calls. Point at the VPS to drive it remotely.
RELAY_MCP_URL=http://127.0.0.1:8787/mcp
